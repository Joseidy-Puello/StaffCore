@model StaffCore.Models.Staff

<h2>Detalles del Empleado</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Cédula</dt>
        <dd class="col-sm-10">@Model.Cedula</dd>

        <dt class="col-sm-2">Cargo</dt>
        <dd class="col-sm-10">@Model.Cargo</dd>

        <dt class="col-sm-2">Departamento</dt>
        <dd class="col-sm-10">@Model.Departamento</dd>

        <dt class="col-sm-2">Salario</dt>
        <dd class="col-sm-10">@Model.Salario</dd>

        <dt class="col-sm-2">Fecha Ingreso</dt>
        <dd class="col-sm-10">@Model.FechaIngreso.ToShortDateString()</dd>

        <dt class="col-sm-2">Activo</dt>
        <dd class="col-sm-10">@Model.Activo</dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a> |
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</p>
