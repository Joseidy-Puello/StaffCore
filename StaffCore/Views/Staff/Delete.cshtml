@model StaffCore.Models.Staff

<h2>Eliminar Empleado</h2>

<div>
    <h4>¿Seguro que deseas eliminar este registro?</h4>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
        <dt class="col-sm-2">Cédula</dt>
        <dd class="col-sm-10">@Model.Cedula</dd>
        <dt class="col-sm-2">Cargo</dt>
        <dd class="col-sm-10">@Model.Cargo</dd>
        <dt class="col-sm-2">Departamento</dt>
        <dd class="col-sm-10">@Model.Departamento</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button> |
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
