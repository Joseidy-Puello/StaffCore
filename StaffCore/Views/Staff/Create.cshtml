@model StaffCore.Models.Staff

<h2>Agregar Empleado</h2>

<form asp-action="Create" method="post">
    <div class="form-check">
        <label asp-for="Nombre" class="form-check-label">></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-check">
        <label asp-for="Cedula" class="form-check-label">></label>
        <input asp-for="Cedula" class="form-control" />
    </div>
    <div class="form-check">
        <label asp-for="Cargo" class="form-check-label">></label>
        <input asp-for="Cargo" class="form-control" />
    </div>
    <div class="form-check">
        <label asp-for="Departamento" class="form-check-label">></label>
        <input asp-for="Departamento" class="form-control" />
    </div>
    <div class="form-check">
        <label asp-for="Salario" class="form-check-label">></label>
        <input asp-for="Salario" class="form-control" />
    </div>
    <div class="form-chek">
        <label asp-for="FechaIngreso" class="form-check-label">></label>
        <input asp-for="FechaIngreso" type="date" class="form-control" />
    </div>
    <div class="form-check">
        <label asp-for="Activo" class="form-check-label">></label>
        <input asp-for="Activo" type="checkbox" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
</form>
